# Copy to .env.local (never commit real values). All variables are optional.

# Indexing: on Vercel, VERCEL_ENV decides (production = indexable, preview = noindex).
# On other hosts pages are indexable unless you set this to "false" (e.g. on a staging server).
NEXT_PUBLIC_ALLOW_INDEXING=true

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty for no analytics script.
# When set, GA4 loads only after the visitor accepts the analytics notice.
NEXT_PUBLIC_GA4_ID=

# Google Search Console HTML-tag verification token (content value only). Leave empty to omit.
NEXT_PUBLIC_GSC_VERIFICATION=
